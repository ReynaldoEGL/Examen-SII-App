APP_NAME="SII Academico API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

DB_CONNECTION=pgsql
DB_HOST=YOUR_SUPABASE_SESSION_POOLER_HOST
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=YOUR_SUPABASE_POOLER_USERNAME
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require

INTERNAL_SHARED_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_NEXT
# HMAC exclusivo de Laravel, distinto de APP_KEY e INTERNAL_SHARED_SECRET.
PSEUDONYM_KEY=REPLACE_WITH_64_HEX_CHARACTERS_GENERATED_RANDOMLY
SII_API_BASE_URL=https://sii.celaya.tecnm.mx/api
SII_TIMEOUT=15

ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
